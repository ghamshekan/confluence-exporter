{
  "manifest_version": 3,
  "name": "Confluence HTML Exporter",
  "version": "1.0.1",
  "description": "Export rendered Confluence pages with resilient filename handling, local images and SVG diagrams.",
  "permissions": [
    "activeTab",
    "downloads",
    "scripting"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Confluence HTML Exporter",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
